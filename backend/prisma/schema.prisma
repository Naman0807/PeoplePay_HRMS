// PeoplePay360 — 1:1 translation of AGENT.md §3.
// Field names are snake_case on purpose: they match the SQL columns in §3 exactly,
// so API payloads need no mapping layer and the frontend sees the documented names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum ContractState {
  DRAFT
  RUNNING
  EXPIRED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum RequestUnit {
  DAYS
  HOURS
}

enum LeaveState {
  TO_APPROVE
  APPROVED
  REFUSED
}

enum RuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

enum AmountSelect {
  FIXED
  PERCENT
  FORMULA
}

enum PayrunState {
  DRAFT
  COMPUTED
  CONFIRMED
  PAID
}

enum PayslipState {
  DRAFT
  DONE
  PAID
}

model User {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(120)
  login         String       @unique @db.VarChar(160)
  password_hash String
  role          Role
  status        ActiveStatus @default(ACTIVE)
  employee_id   Int?         @unique
  created_at    DateTime     @default(now()) @db.Timestamptz(6)

  employee Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  @@map("users")
}

model ResourceCalendar {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(80)
  hours_per_week Decimal @default(40) @db.Decimal(5, 2)
  days_per_week  Int     @default(5)
  timezone       String? @default("Asia/Kolkata") @db.VarChar(40)

  employees Employee[]
  contracts Contract[]
  days      ResourceCalendarDay[]

  @@map("resource_calendars")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// A calendar's day-by-day breakdown, separate from the aggregate hours_per_week/
// days_per_week above. Deliberately not kept in sync with those — payroll's
// workingDays() only ever reads days_per_week as a count (see lib/payroll.ts), never
// which specific weekdays, so this table has no payroll-side effect either way.
model ResourceCalendarDay {
  id                    Int     @id @default(autoincrement())
  resource_calendar_id  Int
  day                   Weekday
  start_time            String  @db.VarChar(5) // "09:00", kept as plain text — no date/timezone math needed here
  end_time              String  @db.VarChar(5)
  break_minutes         Int     @default(0)

  resource_calendar ResourceCalendar @relation(fields: [resource_calendar_id], references: [id], onDelete: Cascade)

  @@unique([resource_calendar_id, day])
  @@map("resource_calendar_days")
}

model Employee {
  id                   Int          @id @default(autoincrement())
  name                 String       @db.VarChar(120)
  work_email           String       @unique @db.VarChar(160)
  department           String?      @db.VarChar(80)
  job_title            String?      @db.VarChar(80)
  manager_id           Int?
  resource_calendar_id Int?
  status               ActiveStatus @default(ACTIVE)
  created_at           DateTime     @default(now()) @db.Timestamptz(6)

  manager           Employee?         @relation("EmployeeManager", fields: [manager_id], references: [id], onDelete: SetNull)
  reports           Employee[]        @relation("EmployeeManager")
  resource_calendar ResourceCalendar? @relation(fields: [resource_calendar_id], references: [id], onDelete: Restrict)

  users             User[]
  contracts         Contract[]
  attendances       Attendance[]
  leave_allocations LeaveAllocation[]
  leave_requests    LeaveRequest[]    @relation("LeaveRequester")
  approved_leaves   LeaveRequest[]    @relation("LeaveApprover")
  payslips          Payslip[]

  @@map("employees")
}

model Contract {
  id                   Int           @id @default(autoincrement())
  employee_id          Int
  reference            String        @unique @db.VarChar(40)
  wage                 Decimal       @db.Decimal(12, 2)
  start_date           DateTime      @db.Date
  end_date             DateTime?     @db.Date
  resource_calendar_id Int?
  structure_id         Int?
  state                ContractState @default(DRAFT)
  created_at           DateTime      @default(now()) @db.Timestamptz(6)

  employee          Employee          @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  resource_calendar ResourceCalendar? @relation(fields: [resource_calendar_id], references: [id])
  structure         PayrollStructure? @relation(fields: [structure_id], references: [id])
  payslips          Payslip[]

  @@index([employee_id])
  @@index([state])
  @@map("contracts")
}

// Deviation from §3, per design spec: worked_hours is computed in application code,
// not a Postgres GENERATED column (no clean Prisma equivalent).
model Attendance {
  id           Int              @id @default(autoincrement())
  employee_id  Int
  check_in     DateTime         @db.Timestamptz(6)
  check_out    DateTime?        @db.Timestamptz(6)
  worked_hours Decimal?         @db.Decimal(6, 2)
  status       AttendanceStatus @default(PRESENT)
  notes        String?

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("attendances")
}

model LeaveType {
  id                  Int         @id @default(autoincrement())
  name                String      @db.VarChar(60)
  request_unit        RequestUnit @default(DAYS)
  requires_allocation Boolean     @default(true)
  active              Boolean     @default(true)

  allocations LeaveAllocation[]
  requests    LeaveRequest[]

  @@map("leave_types")
}

model LeaveAllocation {
  id             Int        @id @default(autoincrement())
  employee_id    Int
  leave_type_id  Int
  number_of_days Decimal    @db.Decimal(5, 2)
  validity_start DateTime?  @db.Date
  validity_end   DateTime?  @db.Date
  state          LeaveState @default(APPROVED)

  employee   Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)

  @@index([employee_id, leave_type_id])
  @@map("leave_allocations")
}

model LeaveRequest {
  id             Int        @id @default(autoincrement())
  employee_id    Int
  leave_type_id  Int
  date_from      DateTime   @db.Date
  date_to        DateTime   @db.Date
  number_of_days Decimal    @db.Decimal(5, 2)
  state          LeaveState @default(TO_APPROVE)
  approver_id    Int?
  reason         String?
  created_at     DateTime   @default(now()) @db.Timestamptz(6)

  employee   Employee  @relation("LeaveRequester", fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Restrict)
  approver   Employee? @relation("LeaveApprover", fields: [approver_id], references: [id])

  @@index([employee_id])
  @@index([state])
  @@map("leave_requests")
}

model PayrollStructure {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(80)
  active Boolean @default(true)

  salary_rules SalaryRule[]
  contracts    Contract[]
  payslip_runs PayslipRun[]
  payslips     Payslip[]

  @@map("payroll_structures")
}

model SalaryRule {
  id                Int           @id @default(autoincrement())
  structure_id      Int
  code              String        @db.VarChar(20)
  name              String        @db.VarChar(80)
  category          RuleCategory?
  sequence          Int
  amount_select     AmountSelect?
  amount_fixed      Decimal?      @db.Decimal(12, 2)
  amount_percent    Decimal?      @db.Decimal(5, 2)
  percent_base_code String?       @db.VarChar(20)
  formula           String?

  structure PayrollStructure @relation(fields: [structure_id], references: [id], onDelete: Cascade)

  @@unique([structure_id, code])
  @@index([structure_id, sequence])
  @@map("salary_rules")
}

model PayslipRun {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(80)
  structure_id Int
  date_start   DateTime    @db.Date
  date_end     DateTime    @db.Date
  state        PayrunState @default(DRAFT)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)

  structure PayrollStructure @relation(fields: [structure_id], references: [id])
  payslips  Payslip[]

  @@map("payslip_runs")
}

model Payslip {
  id           Int          @id @default(autoincrement())
  employee_id  Int
  payrun_id    Int
  contract_id  Int
  structure_id Int
  date_from    DateTime     @db.Date
  date_to      DateTime     @db.Date
  worked_days  Decimal?     @db.Decimal(5, 2)
  gross_amount Decimal?     @db.Decimal(12, 2)
  net_amount   Decimal?     @db.Decimal(12, 2)
  state        PayslipState @default(DRAFT)
  warning_code String?      @db.VarChar(30)

  employee  Employee         @relation(fields: [employee_id], references: [id])
  payrun    PayslipRun       @relation(fields: [payrun_id], references: [id], onDelete: Cascade)
  contract  Contract         @relation(fields: [contract_id], references: [id])
  structure PayrollStructure @relation(fields: [structure_id], references: [id])
  line_ids  PayslipLine[]

  @@index([employee_id])
  @@index([payrun_id])
  @@map("payslips")
}

// This table IS the audit trail: any later formula rule reads a prior row here by rule_code.
model PayslipLine {
  id         Int     @id @default(autoincrement())
  payslip_id Int
  rule_code  String  @db.VarChar(20)
  rule_name  String  @db.VarChar(80)
  amount     Decimal @db.Decimal(12, 2)
  sequence   Int

  payslip Payslip @relation(fields: [payslip_id], references: [id], onDelete: Cascade)

  @@index([payslip_id])
  @@map("payslip_lines")
}
