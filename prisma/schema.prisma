// ============================================================================
// PeoplePay360 HR & Payroll Platform — Prisma Schema (PostgreSQL)
// ============================================================================
// 15 core entities · 3NF design · Comprehensive indexes & constraints
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  EMPLOYEE
  HR_MANAGER
  HR_PAYROLL_USER
  HR_PAYROLL_MANAGER
  ADMIN
}

enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ContractStatus {
  DRAFT
  RUNNING
  EXPIRED
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOffUnit {
  DAYS
  HOURS
}

enum AllocationStatus {
  DRAFT
  APPROVED
  REFUSED
}

enum TimeOffRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REFUSED
}

enum AttendanceStatus {
  NORMAL
  EXCEPTION
  MANUALLY_EDITED
}

enum SalaryRuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  NET
}

enum ComputationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
}

enum PayrunEmployeeStatus {
  PENDING
  COMPUTED
  PAID
}

// ─── 1. USERS ───────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  password_hash String
  first_name   String?
  last_name    String?
  is_active    Boolean       @default(true)
  role         UserRole
  requested_role UserRole?
  approval_status ApprovalStatus @default(APPROVED)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  // Relations — reverse lookups
  employees              Employee[]              @relation("UserEmployees")
  approved_time_off      TimeOffRequest[]        @relation("ApprovedByUser")
  edited_attendances     Attendance[]            @relation("EditedByUser")
  created_payruns        Payrun[]                @relation("PayrunCreatedBy")

  @@index([role])
}

// ─── 3. DEPARTMENTS ─────────────────────────────────────────────────────────

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  created_at DateTime @default(now())

  employees Employee[]

  @@index([name])
}

// ─── 5. WORKING SCHEDULES ───────────────────────────────────────────────────

model WorkingSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  schedule_type String   // e.g. "FULL_TIME", "PART_TIME"
  weekly_hours  Decimal  @db.Decimal(5, 2) // Auto-calculated from ScheduleLines
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  schedule_lines ScheduleLine[]
  employees      Employee[]
  contracts      Contract[]

  @@index([schedule_type])
}

// ─── 6. SCHEDULE LINES ──────────────────────────────────────────────────────

model ScheduleLine {
  id                  String    @id @default(uuid()) @db.Uuid
  working_schedule_id String    @db.Uuid
  day_of_week         DayOfWeek
  start_time          DateTime  @db.Time
  end_time            DateTime  @db.Time
  break_duration_mins Int
  created_at          DateTime  @default(now())

  working_schedule WorkingSchedule @relation(fields: [working_schedule_id], references: [id], onDelete: Cascade)

  @@unique([working_schedule_id, day_of_week])
  @@index([working_schedule_id])
}

// ─── 2. EMPLOYEES ───────────────────────────────────────────────────────────

model Employee {
  id                   String         @id @default(uuid()) @db.Uuid
  user_id              String         @unique @db.Uuid
  first_name           String
  last_name            String
  email                String
  department_id        String?        @db.Uuid
  manager_id           String?        @db.Uuid
  job_position         String
  working_schedule_id  String?        @db.Uuid
  status               EmployeeStatus @default(ACTIVE)
  bank_account_no      String?
  bank_name            String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  // Relations
  user              User             @relation("UserEmployees", fields: [user_id], references: [id], onDelete: Cascade)
  department        Department?      @relation(fields: [department_id], references: [id], onDelete: Restrict)
  manager           Employee?        @relation("ManagerEmployees", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates      Employee[]       @relation("ManagerEmployees")
  working_schedule  WorkingSchedule? @relation(fields: [working_schedule_id], references: [id], onDelete: Restrict)

  // Child relations
  contracts              Contract[]
  time_off_allocations   TimeOffAllocation[]
  time_off_requests      TimeOffRequest[]
  attendances            Attendance[]
  payslips               Payslip[]
  payrun_employees       PayrunEmployee[]

  @@index([department_id])
  @@index([manager_id])
  @@index([status])
  @@index([user_id])
}

// ─── 11. SALARY STRUCTURES ──────────────────────────────────────────────────

model SalaryStructure {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  code       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contracts Contract[]
  rules     SalaryRule[]
  payruns   Payrun[]

  @@index([code])
  @@index([is_active])
}

// ─── 12. SALARY RULES ──────────────────────────────────────────────────────

model SalaryRule {
  id                 String           @id @default(uuid()) @db.Uuid
  salary_structure_id String          @db.Uuid
  name               String
  code               String
  category           SalaryRuleCategory
  sequence           Int              // Ascending execution order
  computation_type   ComputationType
  amount_fixed       Decimal?         @db.Decimal(12, 2)
  percentage_rate    Decimal?         @db.Decimal(7, 4)
  formula_string     String?
  is_active          Boolean          @default(true)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  salary_structure SalaryStructure @relation(fields: [salary_structure_id], references: [id], onDelete: Cascade)
  payslip_lines    PayslipLine[]

  @@unique([salary_structure_id, code])
  @@index([salary_structure_id])
  @@index([category])
  @@index([sequence])
}

// ─── 4. CONTRACTS ───────────────────────────────────────────────────────────

model Contract {
  id                   String         @id @default(uuid()) @db.Uuid
  employee_id          String         @db.Uuid
  name                 String
  start_date           DateTime       @db.Date
  end_date             DateTime?      @db.Date
  wage                 Decimal        @db.Decimal(12, 2)
  salary_structure_id  String         @db.Uuid
  working_schedule_id  String         @db.Uuid
  status               ContractStatus @default(DRAFT)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  // Relations
  employee         Employee        @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  salary_structure SalaryStructure @relation(fields: [salary_structure_id], references: [id], onDelete: Restrict)
  working_schedule WorkingSchedule @relation(fields: [working_schedule_id], references: [id], onDelete: Restrict)
  payslips         Payslip[]

  @@index([employee_id])
  @@index([salary_structure_id])
  @@index([status])
  @@index([start_date, end_date])
  // ┌─────────────────────────────────────────────────────────────────────┐
  // │ BUSINESS RULE: No overlapping RUNNING contracts for the same       │
  // │ employee must be enforced at the APPLICATION layer. A unique partial│
  // │ index cannot be expressed in Prisma alone; use a database trigger  │
  // │ or application-level guard (e.g. check in a transaction before     │
  // │ upserting a RUNNING contract).                                     │
  // └─────────────────────────────────────────────────────────────────────┘
}

// ─── 7. TIME OFF TYPES ──────────────────────────────────────────────────────

model TimeOffType {
  id                   String  @id @default(uuid()) @db.Uuid
  name                 String
  unit                 TimeOffUnit
  requires_allocation  Boolean @default(true)
  payroll_integration  Boolean @default(false)
  created_at           DateTime @default(now())

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]

  @@index([name])
}

// ─── 8. TIME OFF ALLOCATIONS ────────────────────────────────────────────────

model TimeOffAllocation {
  id              String           @id @default(uuid()) @db.Uuid
  employee_id     String           @db.Uuid
  time_off_type_id String          @db.Uuid
  allocated_units Decimal          @db.Decimal(7, 2)
  taken_units     Decimal          @default(0) @db.Decimal(7, 2)
  valid_from      DateTime         @db.Date
  valid_to        DateTime         @db.Date
  status          AllocationStatus @default(DRAFT)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  employee      Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  time_off_type TimeOffType  @relation(fields: [time_off_type_id], references: [id], onDelete: Restrict)

  @@index([employee_id])
  @@index([time_off_type_id])
  @@index([status])
  @@index([valid_from, valid_to])
}

// ─── 9. TIME OFF REQUESTS ──────────────────────────────────────────────────

model TimeOffRequest {
  id               String              @id @default(uuid()) @db.Uuid
  employee_id      String              @db.Uuid
  time_off_type_id String              @db.Uuid
  start_date       DateTime            @db.Date
  end_date         DateTime            @db.Date
  duration         Decimal             @db.Decimal(7, 2)
  status           TimeOffRequestStatus @default(DRAFT)
  approved_by      String?             @db.Uuid
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  employee      Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  time_off_type TimeOffType  @relation(fields: [time_off_type_id], references: [id], onDelete: Restrict)
  approver      User?        @relation("ApprovedByUser", fields: [approved_by], references: [id], onDelete: SetNull)

  @@index([employee_id])
  @@index([time_off_type_id])
  @@index([status])
  @@index([start_date, end_date])
}

// ─── 10. ATTENDANCES ───────────────────────────────────────────────────────

model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  employee_id   String           @db.Uuid
  date          DateTime         @db.Date
  check_in      DateTime?
  check_out     DateTime?
  worked_hours  Decimal?         @db.Decimal(5, 2)
  status        AttendanceStatus @default(NORMAL)
  edited_by     String?          @db.Uuid
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  employee   Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  editor     User?    @relation("EditedByUser", fields: [edited_by], references: [id], onDelete: SetNull)

  @@unique([employee_id, date])
  @@index([employee_id])
  @@index([date])
  @@index([status])
}

// ─── 13. PAYRUNS ────────────────────────────────────────────────────────────

model Payrun {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  salary_structure_id String      @db.Uuid
  period_start       DateTime     @db.Date
  period_end         DateTime     @db.Date
  status             PayrunStatus @default(DRAFT)
  created_by         String       @db.Uuid
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  salary_structure SalaryStructure @relation(fields: [salary_structure_id], references: [id], onDelete: Restrict)
  creator          User            @relation("PayrunCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  payslips         Payslip[]
  payrun_employees PayrunEmployee[]

  @@index([salary_structure_id])
  @@index([created_by])
  @@index([status])
  @@index([period_start, period_end])
}

// ─── 14. PAYSLIPS ──────────────────────────────────────────────────────────

model Payslip {
  id               String        @id @default(uuid()) @db.Uuid
  payrun_id        String        @db.Uuid
  employee_id      String        @db.Uuid
  contract_id      String        @db.Uuid
  basic_amount     Decimal       @db.Decimal(12, 2)
  gross_amount     Decimal       @db.Decimal(12, 2)
  deduction_amount Decimal       @db.Decimal(12, 2)
  net_amount       Decimal       @db.Decimal(12, 2)
  worked_days      Decimal       @db.Decimal(5, 2)
  status           PayslipStatus @default(DRAFT)
  warnings         Json?         // Array of warning strings
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  // Relations
  payrun   Payrun   @relation(fields: [payrun_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  lines    PayslipLine[]

  @@index([payrun_id])
  @@index([employee_id])
  @@index([contract_id])
  @@index([status])
}

// ─── 15. PAYSLIP LINES ─────────────────────────────────────────────────────

model PayslipLine {
  id            String              @id @default(uuid()) @db.Uuid
  payslip_id    String              @db.Uuid
  salary_rule_id String             @db.Uuid
  code          String
  category      SalaryRuleCategory
  rate          Decimal             @db.Decimal(12, 4)
  amount        Decimal             @db.Decimal(12, 2)
  created_at    DateTime            @default(now())

  payslip     Payslip    @relation(fields: [payslip_id], references: [id], onDelete: Cascade)
  salary_rule SalaryRule @relation(fields: [salary_rule_id], references: [id], onDelete: Restrict)

  @@index([payslip_id])
  @@index([salary_rule_id])
  @@index([category])
}

// ─── 13b. PAYRUN EMPLOYEES (join model — added via migration 20260905000000) ──

model PayrunEmployee {
  id         String   @id @default(uuid()) @db.Uuid
  payrun_id  String   @db.Uuid
  employee_id String  @db.Uuid
  base_salary      Decimal                  @default(0) @db.Decimal(12, 2)
  gross_salary     Decimal                  @default(0) @db.Decimal(12, 2)
  total_deductions Decimal                  @default(0) @db.Decimal(12, 2)
  net_salary       Decimal                  @default(0) @db.Decimal(12, 2)
  status           PayrunEmployeeStatus     @default(PENDING)
  created_at DateTime @default(now())

  payrun   Payrun   @relation(fields: [payrun_id], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Restrict)

  @@unique([payrun_id, employee_id])
  @@index([payrun_id])
  @@index([employee_id])
}
